# Chave da OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo que responde no chat (padrão: anthropic/claude-sonnet-4.5)
OPENROUTER_MODEL=
# Modelo que extrai os blocos visuais dos documentos (padrão: o mesmo do chat)
OPENROUTER_EXTRACT_MODEL=

# Modelo de decisão que compõe o painel visual (padrão: typesafe-ai/jev)
JEV_MODEL=
# Opcional: rodar o Jev pelo Vercel AI Gateway em vez da OpenRouter
AI_GATEWAY_API_KEY=
